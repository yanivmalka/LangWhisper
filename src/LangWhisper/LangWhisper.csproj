<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- WinForms gives us the tray icon + settings form.
         WPF is enabled only to pull in the UI Automation client assemblies
         (System.Windows.Automation) used for caret / editable-field detection. -->
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>

    <AssemblyName>LangWhisper</AssemblyName>
    <RootNamespace>LangWhisper</RootNamespace>
    <Version>0.1.0</Version>
    <Product>LangWhisper</Product>
    <Description>Announces the active keyboard language with a whisper or soft beep when you focus a text field.</Description>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- No NuGet packages: TTS is late-bound SAPI COM, so `dotnet build` works offline. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
